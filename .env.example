# Deployer private key used for the xlayerTestnet network in hardhat.config.ts
# and by the publisher service (service/) to sign transactions.
PRIVATE_KEY=

# Used by the publisher service (service/server.ts).
CONTRACT_ADDRESS=0x5380fadFeF5EaEBCE964Da4248d9327b84726Ed3
CHAIN_ID=1952
RPC_URL=https://testrpc.xlayer.tech/terigon
# Optional, defaults to 3001.
PORT=3001

# --- Detector (detector/) ---
# Self-contained signal generator: polls MEXC's public futures API (free,
# no key) for the pump-and-fade short setup, asks a conviction provider to
# rate candidates that clear the deterministic screen, and publishes/
# resolves through the publisher service above. See README.md.

# How often to run a full scan cycle, in milliseconds.
DETECTOR_POLL_INTERVAL_MS=60000

# Minimum 24h price change (as a decimal, e.g. 0.2 = 20%) to bother doing a
# deeper check on a pair -- a cheap pre-filter so candle data isn't fetched
# for every single pair on every cycle.
DETECTOR_PREFILTER_RISE_RATE=0.2

# Out of the 6 deterministic checklist items (pump %, freshness, volume,
# funding rate, market cap, BTC trend), how many must pass before a
# candidate is sent to the conviction provider. Max is 6.
DETECTOR_DETERMINISTIC_THRESHOLD=5

# MEXC has changed this base domain before -- check
# https://www.mexc.com/api-docs/futures if requests start failing.
MEXC_FUTURES_BASE_URL=https://api.mexc.com

# Which ConvictionProvider implementation to use (see
# detector/convictionProvider.ts). Only "gemini" is implemented today; the
# interface exists so another model can be added without touching detection
# or publishing.
CONVICTION_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Free-tier model to call for conviction ratings. Defaults to Google's
# rolling "latest Flash-Lite" alias -- the highest-daily-quota free-tier
# text model -- rather than a pinned version, since pinned Flash-Lite
# versions get retired for new API keys ("no longer available to new
# users") on a schedule outside this project's control; the alias always
# resolves to whatever the current one is. Pin an exact model (e.g.
# gemini-3.5-flash-lite) instead if you want reproducible behavior across
# Google's silent model swaps. Check
# https://ai.google.dev/gemini-api/docs/rate-limits for current free-tier
# RPM/RPD numbers before changing GEMINI_MAX_REQUESTS_PER_* below, since
# quotas are per-model and change over time.
GEMINI_MODEL=gemini-flash-lite-latest

# Client-side caps enforced *before* calling Gemini, so the detector never
# bursts past the free tier. Keep these at or below whatever
# https://ai.google.dev/gemini-api/docs/rate-limits currently lists for
# GEMINI_MODEL.
GEMINI_MAX_REQUESTS_PER_MINUTE=10
GEMINI_MAX_REQUESTS_PER_DAY=200

# Don't re-judge the same symbol within this many minutes, even if it keeps
# qualifying on later cycles.
GEMINI_SYMBOL_COOLDOWN_MINUTES=240

# Retries with exponential backoff on a 429 before giving up on that symbol
# for the current cycle.
GEMINI_MAX_RETRIES=3

# Minimum Gemini conviction (0-10) required to publish a signal on-chain.
DETECTOR_CONVICTION_THRESHOLD=7

# Stop price is placed this far above the swing high since the pump started
# (as a decimal, e.g. 0.02 = 2%), since Gemini here only returns a
# conviction rating -- not a suggested stop/target.
DETECTOR_STOP_BUFFER_PCT=0.02

# Target price is set this many multiples of risk (entry-to-stop distance)
# below entry. 2 = a 1:2 risk:reward target.
DETECTOR_TARGET_RR_MULTIPLE=2

# The local Priori publisher service from above. Never point this at a
# non-local address.
PRIORI_PUBLISHER_URL=http://127.0.0.1:3001
