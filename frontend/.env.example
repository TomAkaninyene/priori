# Public read-only RPC endpoint for X Layer testnet.
VITE_RPC_URL=https://testrpc.xlayer.tech/terigon

# Deployed SignalLedger contract address.
VITE_CONTRACT_ADDRESS=0x5380fadFeF5EaEBCE964Da4248d9327b84726Ed3

# Chain ID for X Layer testnet.
VITE_CHAIN_ID=1952

# Informational only -- mirrors the detector's own DETECTOR_CONVICTION_THRESHOLD
# and DETECTOR_MIN_RR (see root .env / detector/config.ts) so the dashboard can
# tell a reader what filter produced this record. Not read from the detector at
# runtime (this frontend has no backend) -- keep these in sync by hand with the
# detector's *actual configured* values (not just its code defaults) whenever
# they change. Optional; the values below match what the detector currently
# runs with and are also the fallback used if these env vars are unset.
VITE_CONVICTION_THRESHOLD=6
VITE_MIN_RR=1.5
